{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sleep-classifier:epoch-response:1.0.0",
  "title": "Prepared-epoch prediction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "participant_id",
    "time",
    "prediction",
    "probabilities",
    "history_epochs",
    "reset_reason"
  ],
  "properties": {
    "participant_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "time": {
      "type": "number"
    },
    "prediction": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "probabilities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "history_epochs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "reset_reason": {
      "enum": [
        null,
        "participant_change",
        "segment_change",
        "time_gap"
      ]
    }
  }
}
